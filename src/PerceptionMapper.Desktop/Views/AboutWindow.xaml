<Window x:Class="PerceptionMapper.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About — Perception Mapper"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Style="{StaticResource CardBorder}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Perception Mapper" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Communication Practice Platform" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                    <TextBlock Text="Mars Tech Campus" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="What is this project?" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14">
                        Perception Mapper helps you practice professional communication offline. It detects emotional tone,
                        flags biased language, scores your delivery, and coaches your speaking using voice and text — in
                        English, Tamil, and Sinhala.
                    </TextBlock>

                    <TextBlock Text="Main features" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14" LineHeight="24">
                        • Five emotional tones (Neutral, Assertive, Empathetic, Defensive, Persuasive)&#x0a;
                        • Bias detection with category and severity&#x0a;
                        • Practice scenarios (interview, apology, team update, complaints)&#x0a;
                        • Communication score (0–100) with coaching feedback&#x0a;
                        • Voice input, live coach, filler-word detection&#x0a;
                        • Practice session history and exportable reports&#x0a;
                        • Fully offline — local API and SQLite database
                    </TextBlock>

                    <TextBlock Text="How it works" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14">
                        1. Sign in · 2. Choose a scenario · 3. Speak or type your message ·
                        4. Review analysis results (score, tone, bias, suggestions) ·
                        5. Sessions save when the API is running.
                    </TextBlock>

                    <TextBlock Text="Technology" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14">
                        C# · .NET 8 · WPF desktop · ASP.NET Core API · SQLite ·
                        rule-based NLP engines · Windows speech (STT/TTS).
                    </TextBlock>

                    <Border Background="#F0F9FF" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Built by" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                <Run FontWeight="SemiBold">Suwedha</Run><Run>  — Software Idea Planner </Run>
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyText}">
                                <Run FontWeight="SemiBold">Abdullah</Run><Run>  — Software Developer </Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Close" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Padding="24,10"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
