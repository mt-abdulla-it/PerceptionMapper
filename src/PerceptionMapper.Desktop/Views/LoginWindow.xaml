<Window x:Class="PerceptionMapper.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perception Mapper — Sign In"
        Height="520" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Showcase / branding panel -->
        <Border Grid.Column="0" CornerRadius="0" Padding="40,36">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F2744" Offset="0"/>
                    <GradientStop Color="#1E3A5F" Offset="0.55"/>
                    <GradientStop Color="#0E9AA7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="PERCEPTION MAPPER" FontSize="11" FontWeight="Bold" Foreground="#94E2E8"/>
                    <TextBlock Text="Communication&#x0a;Practice Platform" FontSize="32" FontWeight="Bold" Foreground="White"
                               LineHeight="38" Margin="0,8,0,12"/>
                    <TextBlock Text="Showcase interface for tone detection, bias awareness, and professional speaking practice."
                               Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" MaxWidth="360" LineHeight="22"/>

                    <StackPanel Margin="0,28,0,0">
                        <TextBlock Text="English · Tamil · Sinhala" FontSize="12" Foreground="#94E2E8" Margin="0,0,0,12"/>
                        <Border Background="#163D5C" BorderBrush="#38BDF8" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left">
                            <TextBlock Text="Offline · Voice coach · Scenario practice" Foreground="#E0F2FE" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Mars Tech Campus" FontSize="13" FontWeight="SemiBold" Foreground="#94E2E8" Margin="0,0,0,12"/>
                    <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold">Suwedha</Run>
                        <Run Foreground="#CBD5E1"> — Software Idea Planner </Run>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="14">
                        <Run FontWeight="SemiBold">Abdullah</Run>
                        <Run Foreground="#CBD5E1"> — Software Developer </Run>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sign in -->
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" Padding="40,36">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Sign in to start your practice session" Style="{StaticResource CaptionText}" Margin="0,6,0,28"/>

                <TextBlock Text="Username" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="demo"/>

                <TextBlock Text="Password" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12"/>

                <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           MinHeight="22" FontSize="12" Margin="0,0,0,8"/>

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="0,8,0,10"
                        Click="Login_Click"/>
                <Button Content="Create account" Style="{StaticResource GhostButton}" Click="Register_Click"/>

                <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionText}">
                    <Run Text="Demo — username "/><Run Text="demo" FontWeight="Bold"/><Run Text=" · password "/><Run Text="Demo@123" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
